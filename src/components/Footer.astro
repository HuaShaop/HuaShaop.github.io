---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div
      class="my-2 flex flex-col items-center gap-1 text-sm sm:flex-row sm:gap-3"
    >
      <span>{t.footer.copyright} &#169; {currentYear} Cedric</span>
      <span class="hidden sm:inline">&middot;</span>
      <span>
        内容按
        <a
          class="text-accent underline decoration-dashed underline-offset-4"
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
          target="_blank"
          rel="noopener">CC BY-NC-SA 4.0</a
        >授权
      </span>
      <span class="hidden sm:inline">&middot;</span>
      <span class="font-mono text-xs">
        built with <a
          class="text-accent"
          href="https://astro.build"
          target="_blank"
          rel="noopener">Astro</a
        > &amp;
        <a
          class="text-accent"
          href="https://github.com/satnaing/astro-paper"
          target="_blank"
          rel="noopener">Astro Paper</a
        >
      </span>
    </div>
  </div>
</footer>

---
import type { Project } from "@/data/projects";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<li
  class="border-border hover:border-accent rounded-xl border p-5 transition-colors"
>
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-lg font-semibold">{project.title}</h3>
    <span class="text-muted-foreground font-mono text-xs">{project.year}</span>
  </div>

  <p class="text-muted-foreground mt-1 font-mono text-xs">
    {project.tagline}
  </p>

  <p class="mt-3 text-sm leading-relaxed">{project.description}</p>

  <div class="mt-4 flex flex-wrap gap-1.5">
    {
      project.stack.map(item => (
        <span class="border-border text-muted-foreground rounded-full border px-2 py-0.5 font-mono text-[11px]">
          {item}
        </span>
      ))
    }
  </div>

  <div class="mt-4 flex gap-4 font-mono text-sm">
    {
      project.demo && (
        <a
          class="text-accent hover:underline"
          href={project.demo}
          target="_blank"
          rel="noopener"
        >
          demo ↗
        </a>
      )
    }
    {
      project.repo && (
        <a
          class="text-accent hover:underline"
          href={project.repo}
          target="_blank"
          rel="noopener"
        >
          source ↗
        </a>
      )
    }
  </div>
</li>

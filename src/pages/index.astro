---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { projects } from "@/data/projects";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const projectsPath = getRelativeLocaleUrl(locale, "projects");
const rssPath = getRelativeLocaleUrl(locale, "rss.xml").replace(/\/$/, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-10">
      <p class="text-accent font-mono text-xs tracking-[0.2em] uppercase">
        /hello, world
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Cedric
      </h1>
      <p class="mt-4 max-w-2xl text-xl leading-relaxed">
        I build small, fast things for the web — and take them apart to see how
        they work.
      </p>
      <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
        白天写 Web，晚上折腾 AI、物理引擎和 4X 游戏。这里是我的公开笔记本：文章、项目和实验。
      </p>

      <dl
        class="mt-8 grid gap-x-6 gap-y-2 font-mono text-sm sm:grid-cols-[6rem_1fr]"
      >
        <dt class="text-muted-foreground">now</dt>
        <dd>
          building{" "}
          <a
            class="text-accent underline decoration-dashed underline-offset-4"
            href="https://huashaop.github.io/physics-sandbox/"
            target="_blank"
            rel="noopener">physics-sandbox</a
          >{" "}
          — a 2D physics playground that runs in the browser
        </dd>
        <dt class="text-muted-foreground">stack</dt>
        <dd>TypeScript · Astro · Python · Canvas</dd>
        <dt class="text-muted-foreground">rss</dt>
        <dd>
          <a
            class="text-accent underline decoration-dashed underline-offset-4"
            href={rssPath}>/rss.xml</a
          >
        </dd>
        <dt class="text-muted-foreground">elsewhere</dt>
        <dd class="flex items-center">
          <Socials />
        </dd>
      </dl>
    </section>

    <section id="projects" class="border-border border-b py-10">
      <div class="mb-5 flex items-baseline justify-between gap-4">
        <h2 class="text-2xl font-semibold tracking-tight">Selected work</h2>
        <LinkButton
          href={projectsPath}
          class="text-muted-foreground hover:text-accent font-mono text-sm"
        >
          all projects →
        </LinkButton>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {projects.map(project => <ProjectCard project={project} />)}
      </ul>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
